# vestige 설정 파일 예시
#
# 이 파일을 ~/vestige/config.env 로 복사하고 원하는 값만 주석 해제하세요.
#   (Windows: C:\Users\<사용자>\vestige\config.env)
#
# 여기 적은 값은 CLI · 야간 정제 스케줄러 · 웹 UI 모두 자동으로 읽습니다.
# 실제 OS 환경변수가 있으면 그쪽이 우선합니다(이 파일은 기본값 역할).
# 확인:  python -m vestige config
#
# 형식: KEY=VALUE  (# 로 시작하면 주석, 따옴표 선택)

# ── 정제 백엔드 ────────────────────────────────────────────────
# claude(기본) / anthropic / openai / gemini / ollama / off
#VESTIGE_ENRICH_BACKEND=claude

# 로컬 모델(Ollama) — 완전 오프라인·무료·유출0. Ollama 실행 필요.
#VESTIGE_ENRICH_BACKEND=ollama
#VESTIGE_OLLAMA_MODEL=llama3.1
#VESTIGE_OLLAMA_URL=http://localhost:11434/v1

# GPT (OpenAI). 키는 여기 적어도 되지만 이 파일은 절대 git에 올리지 마세요.
#VESTIGE_ENRICH_BACKEND=openai
#OPENAI_API_KEY=sk-...
#VESTIGE_OPENAI_MODEL=gpt-4o-mini

# Gemini (Google)
#VESTIGE_ENRICH_BACKEND=gemini
#GEMINI_API_KEY=...
#VESTIGE_GEMINI_MODEL=gemini-2.0-flash

# Anthropic API (Claude Code 구독 대신 API 키로)
#VESTIGE_ENRICH_BACKEND=anthropic
#ANTHROPIC_API_KEY=sk-ant-...
#VESTIGE_ENRICH_API_MODEL=claude-sonnet-5

# ── 경로 (기본값이면 안 적어도 됨) ────────────────────────────
#VESTIGE_DATA_DIR=~/vestige/data
#CLAUDE_PROJECTS_DIR=~/.claude/projects

# ── 임베딩 모델 (변경 시 전체 재색인 필요) ────────────────────
# 기본=int8 e5-large. 저사양 기기는 MiniLM 옵션.
#VESTIGE_EMBED_MODEL=intfloat/multilingual-e5-large-int8
#VESTIGE_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
